{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDyar",
  "version": "0.1.0",
  "identifier": "app.mdyar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDyar",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "shortDescription": "BiDi-first Markdown editor",
    "longDescription": "MDyar is a free, open-source (GPL-3.0) Markdown editor with full bidirectional text support, live preview, themes, and HTML export.",
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
